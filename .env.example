NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local development preview only. It is ignored in production builds.
DASHBOARD_MOCK_MODE=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values used by later Razorpay/webhook work. Never prefix these
# with NEXT_PUBLIC_ and never commit real credentials.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
RAZORPAY_KEY_ID=your-server-side-key-id
RAZORPAY_KEY_SECRET=your-server-only-key-secret
RAZORPAY_WEBHOOK_SECRET=your-server-only-webhook-secret
RAZORPAY_PRO_PLAN_ID=your-server-owned-plan-id

# Preferred for seat billing. Each Plan must be monthly and match the exact
# computed amount: base + (total seats - 2) * extra-seat price.
RAZORPAY_PLAN_CATALOG_JSON={"2":"plan_replace_for_2_seats","3":"plan_replace_for_3_seats"}
RAZORPAY_CURRENCY=USD
RAZORPAY_BASE_PRICE_SUBUNITS=999
RAZORPAY_EXTRA_SEAT_PRICE_SUBUNITS=750
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# Server-only transactional invitation email. Verify the sender domain before
# production use. Omit these values to keep manual copy-link delivery.
RESEND_API_KEY=re_replace_with_server_only_key
EMAIL_FROM=Quillcrypt <invites@your-domain.com>
EMAIL_REPLY_TO=support@your-domain.com
CRON_SECRET=replace_with_a_long_random_server_only_secret
